# Copy thành .env.local, điền 3 biến. Không gửi khóa server vào chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa server: Secret key sb_secret_* hoặc legacy service_role.
# TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_ cho biến này.
SUPABASE_SECRET_KEY=
# Tương thích tên cũ: SUPABASE_SERVICE_ROLE_KEY=
# Tương thích public key cũ: NEXT_PUBLIC_SUPABASE_ANON_KEY=
